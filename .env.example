# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public address of the app, used in links sent to customers.
# Leave empty locally; set it in production, e.g. https://app.layisha.co.za
NEXT_PUBLIC_APP_URL=

# Optional: send WhatsApp messages automatically through Meta's WhatsApp Cloud API.
# Leave empty to use free "tap to send" WhatsApp links instead.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 3 body variables: {{1}} customer first name, {{2}} business name, {{3}} link
WHATSAPP_LOCATION_TEMPLATE=location_request
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
